# =============================================================================
# JOCTA ENTERPRISES — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` for local development and fill in local values.
# NEVER commit `.env` or real secrets to version control.
# =============================================================================

# Runtime environment: development | test | production
NODE_ENV=development

# Backend HTTP server port
PORT=4000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/jocta_dev

# Direct / unpooled PostgreSQL connection string for migrations (Neon)
DATABASE_URL_UNPOOLED=

# Maximum connections in the PostgreSQL pool
PGPOOL_MAX=10

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Required in production (minimum 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters_in_production
JWT_SECRET=replace_with_at_least_32_random_characters_in_production

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Backend verifies token audience against GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend build-time variable for Google Identity Services button
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated allowlist of authorized administrator Google email addresses.
# Only accounts in this list can access the /admin portal.
ADMIN_EMAILS=ycremy2000@gmail.com

# Session lifetime in hours (default: 24)
SESSION_MAX_AGE_HOURS=24

# Frontend build-time variables (Vite)
VITE_API_URL=http://localhost:4000
VITE_WHATSAPP_NUMBER=254700000000
